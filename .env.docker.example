# Variables para `docker compose --env-file .env.docker up` — copiar a
# .env.docker (gitignored) y llenar con los valores reales de producción.
# NUNCA commitear el archivo real, solo este ejemplo.

# --- MySQL (contenedor nuevo, datos cargados desde un dump de la BD real
# durante el cutover — ver plan de despliegue) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=roma_db
MYSQL_USER=roma_app
MYSQL_PASSWORD=

# --- Backend (mismas variables que backend/.env.example) ---
FRONTEND_URL=https://romascience.com
CONTACT_NOTIFICATION_EMAIL=contacto@romascience.com
CONTACT_WHATSAPP_NUMBER=573150987752
ACTIVATION_TOKEN_TTL_HOURS=48
JWT_SECRET=
COOKIE_SECRET=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_NOTIFICATIONS_USER=notificaciones@romascience.com
ZOHO_NOTIFICATIONS_PASSWORD=
ZOHO_CONTACT_USER=contacto@romascience.com
ZOHO_CONTACT_PASSWORD=

# --- Frontend (build args — se hornean en la imagen, mismas que
# frontend/.env.example) ---
VITE_API_BASE_URL=https://romascience.com/api
VITE_CONTACT_API_ENDPOINT=/contact
VITE_SITE_URL=https://www.romascience.com
VITE_WHATSAPP_NUMBER=573150987752
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61592011318309
VITE_INSTAGRAM_URL=https://www.instagram.com/romascience/
VITE_TIKTOK_URL=https://www.tiktok.com/@roma_science
VITE_X_URL=https://x.com/RoMaScienceA
VITE_CONTACT_EMAIL=contacto@romascience.com
VITE_ERROR_REPORTING_ENDPOINT=
