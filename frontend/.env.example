# En local, apunta al backend Node en /backend (npm run dev, puerto 3000).
# En producción, usa la URL pública del VPS Contabo donde se despliegue el backend
# (ej. https://api.romascience.com o la IP/puerto del VPS detrás de un proxy).
VITE_API_BASE_URL=http://localhost:3000/api
VITE_CONTACT_API_ENDPOINT=/contact
VITE_SITE_URL=https://www.romascience.com
VITE_WHATSAPP_NUMBER=573150987752
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61592011318309
VITE_INSTAGRAM_URL=https://www.instagram.com/romascience/
VITE_TIKTOK_URL=https://www.tiktok.com/@roma_science
VITE_X_URL=https://x.com/RoMaScienceA
VITE_CONTACT_EMAIL=contacto@romascience.com

# Optional — leave empty to disable. If set, runtime errors (Vue + window +
# unhandled promise rejections) are POSTed here as JSON. See src/services/errorReporting.ts.
VITE_ERROR_REPORTING_ENDPOINT=
