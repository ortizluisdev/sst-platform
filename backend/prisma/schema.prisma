generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================
// NÚCLEO: usuarios, organizaciones, roles y servicios
// ============================================================

/// Catálogo de permisos individuales. `key` es el identificador que revisa
/// el código (ej. "dashboard.higiene_industrial.view", "menu.servicios.manage").
/// La clave especial "*" significa "todos los permisos" — ver utils/permissions.ts.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

/// Un rol es un paquete de permisos reutilizable (ej. "super-admin",
/// "org-admin", "org-user"). El sistema se controla por permisos, no por el
/// nombre del rol — el rol es solo el mecanismo para asignar varios permisos
/// a la vez. `isSystem` protege los roles base de borrarse desde la UI futura.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions    RolePermission[]
  platformUsers  User[]
  orgMemberships UserOrganization[]

  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Ciclo de vida de una cuenta creada por un admin (ya no hay autorregistro
/// público — ver Fase B del rediseño de auth). PENDING_ACTIVATION: el admin
/// la creó, el usuario todavía no definió contraseña (passwordHash null).
/// ACTIVE: puede iniciar sesión con normalidad. SUSPENDED: un admin la
/// desactivó (ej. el responsable ya no trabaja ahí) — bloqueada para login,
/// reversible por un admin (reactivar → ACTIVE). Ver auditLogs para
/// quién/cuándo hizo cada transición.
enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

/// CC: cédula de ciudadanía — identifica siempre a una PERSONA (el
/// responsable de una empresa, o un cliente independiente sin empresa). NIT
/// vive en Organization.nit (dato de la empresa), no como credencial de
/// login de un User — hoy no se soporta login directo por NIT sin un
/// responsable asociado.
enum DocumentType {
  CC
  NIT
}

model User {
  id             String        @id @default(cuid())
  documentType   DocumentType  @default(CC) @map("document_type")
  /// Credencial de login (reemplaza email). Único a nivel de plataforma.
  documentNumber String        @unique @map("document_number") @db.VarChar(20)
  /// Dato de contacto — ya no es la credencial de login, por eso no es único.
  email          String        @db.VarChar(255)
  /// Nullable: una cuenta PENDING_ACTIVATION todavía no tiene contraseña —
  /// la define el propio usuario al activar (ver ActivationToken).
  passwordHash   String?       @map("password_hash") @db.VarChar(255)
  nombre         String        @db.VarChar(255)
  cargo          String?       @db.VarChar(150)
  telefono       String?       @db.VarChar(50)
  fotoUrl        String?       @map("foto_url") @db.VarChar(500)
  /// Rol a nivel PLATAFORMA (ej. super-admin). null para un cliente normal:
  /// sus permisos vienen exclusivamente de su(s) UserOrganization.role.
  roleId         String?       @map("role_id")
  accountStatus  AccountStatus @default(PENDING_ACTIVATION) @map("account_status")
  /// Motivo que el admin escribió al suspender — se limpia al reactivar,
  /// para que un motivo viejo no quede colgado tras la reactivación.
  suspendReason  String?       @map("suspend_reason") @db.Text
  /// true tras activar la cuenta por primera vez — el guard de rutas del
  /// frontend fuerza la vista de actualización de datos antes de dejar
  /// pasar a cualquier otra ruta protegida, hasta que se complete.
  mustUpdateProfile Boolean    @default(false) @map("must_update_profile")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  role                  Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  organizations         UserOrganization[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  activationTokens      ActivationToken[]
  notificationsReceived Notification[]       @relation("NotificationRecipient")
  notificationsSent     Notification[]       @relation("NotificationSender")
  variableUploads       VariableUpload[]
  announcements         Announcement[]
  auditLogs             AuditLog[]

  @@index([documentNumber])
  @@index([roleId])
  @@index([accountStatus])
  @@map("users")
}

model Organization {
  id     String @id @default(cuid())
  nombre String @db.VarChar(255)
  /// Nullable: organizaciones creadas antes del rediseño de auth no
  /// necesariamente lo tienen todavía. El flujo de creación de empresa por
  /// el admin (Fase B.3) lo exige a partir de ahora.
  nit          String?  @unique @db.VarChar(20)
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users           UserOrganization[]
  services        OrganizationService[]
  workPoints      WorkPoint[]
  variableUploads VariableUpload[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@map("organizations")
}

/// Relación usuario↔organización. Un usuario tiene un único rol por
/// organización (una fila = una membresía); puede pertenecer a varias
/// organizaciones con roles distintos en cada una. `roleId` es obligatorio:
/// toda membresía necesita un paquete de permisos (ej. "org-admin", "org-user").
model UserOrganization {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([roleId])
  @@map("user_organizations")
}

/// Con qué frecuencia se espera una carga nueva de variables para un
/// servicio. No está confirmado con el cliente final si los 5 servicios
/// comparten periodicidad — se deja configurable por servicio para que el
/// sistema funcione igual sin importar cuál resulte ser el escenario real.
enum UpdateFrequency {
  WEEKLY
  BIWEEKLY
}

/// Catálogo de los 5 servicios que ofrece RoMa.
model Service {
  id              String          @id @default(cuid())
  slug            String          @unique @db.VarChar(100)
  nombre          String          @db.VarChar(255)
  descripcion     String?         @db.Text
  updateFrequency UpdateFrequency @default(WEEKLY) @map("update_frequency")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")

  organizations       OrganizationService[]
  variableDefinitions VariableDefinition[]
  variableUploads     VariableUpload[]

  @@map("services")
}

/// Determina qué dashboards ve cada organización: solo los servicios
/// contratados y activos aparecen en su panel.
model OrganizationService {
  id             Int      @id @default(autoincrement())
  organizationId String   @map("organization_id")
  serviceId      String   @map("service_id")
  isActive       Boolean  @default(true) @map("is_active")
  contractedAt   DateTime @default(now()) @map("contracted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, serviceId])
  @@index([serviceId])
  @@map("organization_services")
}

// ============================================================
// SESIONES Y RECUPERACIÓN DE CONTRASEÑA
// ============================================================

/// Refresh token rotativo: cada uso genera uno nuevo y revoca este.
/// Se guarda solo el hash, nunca el token en texto plano. Cada fila
/// representa además una sesión activa (o ya revocada/expirada).
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.VarChar(191)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Token de un solo uso para activar una cuenta creada por un admin (define
/// contraseña por primera vez). Mismo patrón que PasswordResetToken: se
/// guarda hasheado, usedAt evita reutilizarlo. Expiración configurable por
/// ACTIVATION_TOKEN_TTL_HOURS (ver config/env.ts) — default 48h, más
/// generoso que un reset de contraseña porque un contacto B2B no
/// necesariamente revisa su correo el mismo día.
model ActivationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_tokens")
}

/// Token de un solo uso para restablecer contraseña. Expiración corta
/// (ej. 1 hora), se guarda hasheado, y usedAt evita reutilizarlo.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// NOTIFICACIONES
// ============================================================

/// Eventos de negocio que disparan notificaciones. Agregar uno nuevo es: una
/// entrada acá + una fila en notification-types.ts (registro de
/// severidad/canal/audiencia) + una llamada a NotificationService.notify()
/// desde el módulo de origen — nunca tocar la lógica central del servicio.
/// REGISTRO_PENDIENTE queda del modelo de autorregistro público (eliminado
/// en la Fase B) — sin código que la dispare, pero se deja en el enum en
/// vez de forzar otra migración solo para borrarla.
enum NotificationType {
  SEMAFORO_CRITICO
  CARGA_PROCESADA
  CARGA_CON_ERROR
  CUENTA_SUSPENDIDA
  CUENTA_REACTIVADA
  REGISTRO_PENDIENTE
  CONTACTO_RECIBIDO
}

enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO
}

/// Cada fila es UN destinatario — el "fan-out" a una organización completa o
/// a todos los admins pasa por NotificationService (createMany de una fila
/// por destinatario), no por una relación compartida: cada quien necesita su
/// propio isRead/readAt independiente del resto.
model Notification {
  id             String               @id @default(cuid())
  recipientId    String               @map("recipient_id")
  senderId       String?              @map("sender_id")
  organizationId String?              @map("organization_id")
  type           NotificationType
  severity       NotificationSeverity @default(INFO)
  message        String               @db.Text
  /// Snapshot inmutable del contexto del evento (variable, valor medido,
  /// límite normativo, puesto, archivo, etc.) — no se recalcula ni cambia si
  /// la entidad origen cambia después. Mismo patrón que AuditLog.metadata.
  metadata       Json?
  /// Ruta relativa ya resuelta para el deep-link del frontend.
  link           String?              @map("link") @db.VarChar(500)
  /// Trazabilidad liviana hacia la entidad origen, sin FK real de Prisma
  /// (evita una migración nueva cada vez que se agregue un tipo de evento).
  entityType     String?              @map("entity_type") @db.VarChar(50)
  entityId       String?              @map("entity_id")
  isRead         Boolean              @default(false) @map("is_read")
  readAt         DateTime?            @map("read_at")
  /// Si el tipo de evento decidió (vía notification-types.ts) que este envío
  /// debía intentar ir por email — independiente de si el envío tuvo éxito.
  emailRequested Boolean              @default(false) @map("email_requested")
  emailSentAt    DateTime?            @map("email_sent_at")
  emailError     String?              @map("email_error") @db.Text
  createdAt      DateTime             @default(now()) @map("created_at")

  recipient    User          @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender       User?         @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([organizationId])
  @@index([type])
  @@map("notifications")
}

// ============================================================
// VARIABLES DE SEGURIDAD E HIGIENE OCUPACIONAL
// Cada uno de los 5 servicios tiene su propio catálogo de variables
// (confirmado con la imagen de referencia: ~12 para Higiene Industrial,
// el cliente final menciona ~50 en total — tamaño distinto por servicio).
// ============================================================

enum WorkShift {
  DIURNA
  NOCTURNA
  MIXTA
}

/// Puesto de trabajo evaluado. Pertenece a una organización, no a un
/// servicio específico: el mismo puesto físico puede recibir lecturas de
/// más de un servicio contratado (ej. Higiene Industrial y Riesgo Mecánico
/// sobre el mismo operario) — el servicio queda determinado por qué
/// VariableDefinition/VariableUpload se referencia en cada lectura.
model WorkPoint {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  codigo           String    @db.VarChar(50)
  nombre           String    @db.VarChar(255)
  areaPlanta       String    @map("area_planta") @db.VarChar(255)
  procesoActividad String    @map("proceso_actividad") @db.VarChar(255)
  jornada          WorkShift @default(DIURNA)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  readings     VariableReading[]

  @@unique([organizationId, codigo])
  @@index([organizationId])
  @@map("work_points")
}

/// Cómo se interpreta el rango normativo de una variable al calcular el
/// semáforo: RANGE (debe estar entre limiteMin y limiteMax, ej. iluminancia),
/// MAX_LIMIT (no debe superar limiteMax, ej. ruido), MIN_LIMIT (no debe
/// bajar de limiteMin).
enum VariableComparisonType {
  RANGE
  MAX_LIMIT
  MIN_LIMIT
}

/// Catálogo normativo de variables por servicio (nombre, categoría, rango
/// de cumplimiento, unidad de medida). Los rangos deben confirmarse contra
/// la ficha técnica oficial de cada norma (ISO 7730, ISO 7243, ISO 9612,
/// ISO 8995-1/RETILAP, etc.) antes de producción — los del seed son de
/// referencia técnica real pero no auditados formalmente.
model VariableDefinition {
  id               String                 @id @default(cuid())
  serviceId        String                 @map("service_id")
  /// Libre, no enum: cada servicio define sus propias categorías (para
  /// Higiene Industrial: Iluminación/Ruido/Confort Térmico; otro servicio
  /// tendría categorías completamente distintas).
  categoria        String                 @db.VarChar(100)
  codigo           String                 @db.VarChar(50)
  nombre           String                 @db.VarChar(255)
  unidadMedida     String                 @map("unidad_medida") @db.VarChar(50)
  comparisonType   VariableComparisonType @default(RANGE) @map("comparison_type")
  limiteMin        Float?                 @map("limite_min")
  limiteMax        Float?                 @map("limite_max")
  /// Margen (ej. 0.1 = 10%) más allá de limiteMin/limiteMax que se marca
  /// AMARILLO en vez de ROJO — el semáforo de la imagen de referencia tiene
  /// 3 estados, no un corte binario. Validar el % real contra cada norma.
  toleranciaAlerta Float                  @default(0.1) @map("tolerancia_alerta")
  normativaRef     String?                @map("normativa_ref") @db.VarChar(255)
  isActive         Boolean                @default(true) @map("is_active")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  service  Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  readings VariableReading[]

  @@unique([serviceId, codigo])
  @@index([serviceId])
  @@map("variable_definitions")
}

enum UploadStatus {
  PENDIENTE
  PROCESADO
  ERROR
}

/// Carga de archivo (CSV/Excel) con lecturas de variables de UN servicio de
/// UNA organización, subida por el super-admin (único rol autorizado).
/// organizationId y serviceId son los campos que toda query debe usar para
/// aislar datos por cliente — nunca un parámetro que venga del frontend.
model VariableUpload {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  serviceId       String       @map("service_id")
  uploadedById    String       @map("uploaded_by_id")
  originalFile    String       @map("original_file") @db.VarChar(500)
  /// Fecha real de la evaluación en campo — puede diferir de createdAt
  /// (cuándo se subió el archivo). Es la fecha que se grafica en tendencia.
  fechaEvaluacion DateTime     @map("fecha_evaluacion")
  status          UploadStatus @default(PENDIENTE)
  errorMessage    String?      @map("error_message") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  uploadedBy   User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  readings     VariableReading[]

  @@index([organizationId, serviceId, fechaEvaluacion])
  @@map("variable_uploads")
}

enum SemaphoreStatus {
  VERDE
  AMARILLO
  ROJO
}

/// Lectura individual de una variable en un puesto de trabajo, dentro de
/// una carga, con el resultado del semáforo ya calculado contra
/// VariableDefinition (comparisonType + tolerancia).
model VariableReading {
  id           String          @id @default(cuid())
  uploadId     String          @map("upload_id")
  workPointId  String          @map("work_point_id")
  definitionId String          @map("definition_id")
  valor        Float
  semaforo     SemaphoreStatus
  createdAt    DateTime        @default(now()) @map("created_at")

  upload     VariableUpload     @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  workPoint  WorkPoint          @relation(fields: [workPointId], references: [id], onDelete: Cascade)
  definition VariableDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([uploadId, workPointId, definitionId])
  @@index([workPointId])
  @@index([definitionId])
  @@map("variable_readings")
}

// ============================================================
// LANDING PAGE PÚBLICA Y AUDITORÍA
// ============================================================

model Announcement {
  id          String    @id @default(cuid())
  authorId    String    @map("author_id")
  titulo      String    @db.VarChar(255)
  contenido   String    @db.Text
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([isPublished, publishedAt])
  @@map("announcements")
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ROLE_CHANGED
  ORG_SERVICE_GRANTED
  ORG_SERVICE_REVOKED
  DASHBOARD_ACCESSED
  /// Empresa + responsable creados por un admin (Fase B.3) — reemplaza al
  /// autorregistro público, que ya no existe.
  USER_CREATED_BY_ADMIN
  ACTIVATION_INVITE_RESENT
  ACCOUNT_ACTIVATED
  USER_SUSPENDED
  USER_REACTIVATED
  PROFILE_UPDATED
  VARIABLES_UPLOADED
  /// Fase C: alta de empresa/servicios reorganizada bajo /dashboard/admin.
  ORGANIZATION_UPDATED
  SERVICE_CREATED
  SERVICE_UPDATED
}

/// Registro de acciones sensibles: quién, cuándo, qué. metadata guarda
/// detalles específicos de la acción (ej. rol anterior/nuevo) como JSON.
model AuditLog {
  id             String      @id @default(cuid())
  userId         String?     @map("user_id")
  organizationId String?     @map("organization_id")
  action         AuditAction
  metadata       Json?
  ipAddress      String?     @map("ip_address") @db.VarChar(45)
  createdAt      DateTime    @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============================================================
// FORMULARIO DE CONTACTO (existente, sin cambios de estructura)
// ============================================================

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(255)
  correo    String   @db.VarChar(255)
  telefono  String   @db.VarChar(50)
  empresa   String?  @db.VarChar(255)
  mensaje   String   @db.Text
  ipAddress String   @map("ip_address") @db.VarChar(45)
  emailSent Boolean  @default(false) @map("email_sent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}
