# MySQL — igual en local y en producción, para evitar discrepancias entre entornos.
# Local: crea una base y un usuario dedicados, ej.
#   CREATE DATABASE roma_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'roma_app'@'localhost' IDENTIFIED BY 'tu-password-local';
#   GRANT ALL PRIVILEGES ON roma_db.* TO 'roma_app'@'localhost';
DATABASE_URL="mysql://usuario:password@localhost:3306/roma_db"
# Base de sombra que usa Prisma internamente para calcular migraciones (requiere
# un usuario con permiso CREATE/DROP sobre esta base específica). Nunca se usa
# en runtime, solo durante `prisma migrate dev`. Ej.:
#   CREATE DATABASE roma_db_shadow CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   GRANT ALL PRIVILEGES ON roma_db_shadow.* TO 'roma_app'@'localhost';
SHADOW_DATABASE_URL="mysql://usuario:password@localhost:3306/roma_db_shadow"
PORT=3000
FRONTEND_URL=http://localhost:5173

# Firma de tokens JWT (access + refresh). Debe ser aleatorio, de al menos 32 bytes,
# y distinto entre entornos. Regenerar con:
#   openssl rand -hex 32
JWT_SECRET=reemplaza-esto-con-el-resultado-de-openssl-rand--hex-32

# Firma de las cookies httpOnly (access + refresh token). Debe ser distinto
# de JWT_SECRET y de al menos 32 bytes. Regenerar con:
#   openssl rand -hex 32
COOKIE_SECRET=reemplaza-esto-con-otro-resultado-de-openssl-rand--hex-32

# SMTP — dejar vacío hasta que el correo esté configurado. El envío
# se omite de forma controlada (log, no crash) mientras falten estas variables.
# Dos cuentas separadas: NOTIFICATIONS para todo lo transaccional (reset,
# activación, eventos) y CONTACT para el formulario de contacto humano.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_NOTIFICATIONS_USER=notificaciones@romascience.com
ZOHO_NOTIFICATIONS_PASSWORD=
ZOHO_CONTACT_USER=contacto@romascience.com
ZOHO_CONTACT_PASSWORD=

CONTACT_NOTIFICATION_EMAIL=contacto@romascience.com
CONTACT_WHATSAPP_NUMBER=573150987752
ACTIVATION_TOKEN_TTL_HOURS=48

# Solo usadas por prisma/seed.ts, para las cuentas base (super-admin,
# adminsystem, clientes de prueba). El seed falla explícitamente si falta alguna.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMINSYSTEM_PASSWORD=
SEED_CLIENTE_PASSWORD=
SEED_CLIENTE2_PASSWORD=
