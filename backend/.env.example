# Postgres — en Supabase, usa el "Session pooler" (puerto 5432): funciona bien
# tanto para conexiones persistentes como para redes IPv4, lo más común en
# plataformas como Render.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"
PORT=3000
FRONTEND_URL=http://localhost:5173

# SMTP de Zoho Mail — dejar vacío hasta que el correo esté configurado. El envío
# se omite de forma controlada (log, no crash) mientras falten estas variables.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=contacto@romascience.com
ZOHO_SMTP_PASSWORD=

CONTACT_NOTIFICATION_EMAIL=contacto@romascience.com
