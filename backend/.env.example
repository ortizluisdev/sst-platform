DATABASE_URL="mysql://user:password@host:3306/roma_db"
PORT=3000
FRONTEND_URL=http://localhost:5173

# SMTP de Zoho Mail — dejar vacío hasta que el correo esté configurado. El envío
# se omite de forma controlada (log, no crash) mientras falten estas variables.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=contacto@romascience.com
ZOHO_SMTP_PASSWORD=

CONTACT_NOTIFICATION_EMAIL=contacto@romascience.com
